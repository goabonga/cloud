# Managed by Ansible. GOA_NODE_ID matches an infra_node resource so the
# scheduler can place compute on this host; the agent realizes only its share.
GOA_STATE_DSN={{ state_dsn }}
GOA_KMS_KEY={{ lookup('file', kms_key_file) | trim }}
GOA_NODE_ID={{ inventory_hostname }}
{% if inventory_hostname in groups['edges'] %}
# This edge answers the public DNS zones on an address of the public block.
GOA_DNS_PUBLIC_ADDR={{ dns_public_addr }}
# The public block routed to the edges: public ip_addresses are reserved from
# it, and load balancers are served on theirs.
GOA_PUBLIC_CIDR={{ eip_block }}
{% if upstream.route_mode == 'bgp' %}
# It announces the public addresses it serves to upstream-sim over BGP.
GOA_BGP_ASN={{ edge_asn }}
GOA_BGP_ROUTER_ID={{ (vms | selectattr('name', 'equalto', inventory_hostname) | first).wan_ip }}
GOA_BGP_PEERS={{ (vms | selectattr('name', 'in', groups['upstream']) | first).wan_ip }}@{{ upstream.asn }}
{% endif %}
{% endif %}

# Management certificate: {{ lookup('file', management_pki_dir ~ '/' ~ inventory_hostname ~ '.crt') | hash('sha256') }}
GOA_MANAGEMENT_TLS_CA={{ management_tls_dir }}/ca.crt
GOA_MANAGEMENT_TLS_CERT={{ management_tls_dir }}/node.crt
GOA_MANAGEMENT_TLS_KEY={{ management_tls_dir }}/node.key
