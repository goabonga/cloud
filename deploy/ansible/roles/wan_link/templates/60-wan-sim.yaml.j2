# Managed by Ansible: this host's leg on the wan-sim transit network.
{% set me = vms | selectattr('name', 'equalto', inventory_hostname) | first %}
network:
  version: 2
  ethernets:
    wan-sim:
      match:
        macaddress: "{{ me.wan_mac }}"
      addresses:
        - "{{ me.wan_ip }}/{{ wan_sim.prefix }}"
