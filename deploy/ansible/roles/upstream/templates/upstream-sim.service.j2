[Unit]
Description=upstream-sim: route the public block, inet client, NAT to the LAN
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/upstream-sim-up

[Install]
WantedBy=multi-user.target
