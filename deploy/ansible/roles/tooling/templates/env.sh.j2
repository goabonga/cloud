# Managed by Ansible. Points the infra CLI and the Terraform provider at the
# lab's control plane. Run `infra-login` to fetch a JWT from the IdP into
# GOA_API_TOKEN, which both of them read.
export GOA_API_URL="http://{{ control_ip }}:{{ api_addr | regex_replace('^:', '') }}"
export IDP_URL="{{ idp_issuer }}"
export CLIENT_ID="{{ idp_client_id }}"

infra-login() {
    GOA_API_TOKEN="$(CLIENT_SECRET="$(cat {{ tooling_config_dir }}/terraform-client.secret)" \
        {{ tooling_workspace }}/get-token.sh)" && [ -n "$GOA_API_TOKEN" ] && export GOA_API_TOKEN
}
